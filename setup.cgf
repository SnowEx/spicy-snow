[metadata]
name = spicy-snow
version = 0.3.0
description = Use Sentinel-1 volumetric scattering at C-band to retrieve snow depths.
long_description = file: README.md
long_description_content_type = text/markdown
author = Zachary Hoppinen
author_email = zachhoppinen@gmail.com
url = https://github.com/SnowEx/spicy-snow
license = MIT
classifiers =
    Programming Language :: Python :: 3
    Programming Language :: Python :: 3.9
    License :: OSI Approved :: MIT License
    Operating System :: OS Independent
    Topic :: Scientific/Engineering :: GIS
    Topic :: Scientific/Engineering :: Hydrology

[options]
packages = find:
python_requires = >=3.9
install_requires =
    numpy>=2.3.5
    pandas>=2.3.3
    geopandas>=1.1.1
    shapely>=2.1.2
    xarray>=2025.10.1
    rioxarray>=0.20.0
    requests>=2.32.5
    tqdm>=4.67.1
    asf_search>=0.0.1
    fsspec>=2025.10.0
    rasterio>=1.4.3
    pyproj>=3.7.2
    h5py>=3.15.1
    pygeohydro>=0.19.4
    zarr>=3.1.3
    earthaccess>=0.15.1

[options.packages.find]
exclude =
    tests*